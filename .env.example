# name.com Core API credentials (https://docs.name.com — NOT the deprecated /v4/ docs).
# Get a sandbox token from https://www.name.com/account/settings/api, and use your
# account username with "-test" appended (e.g. "yourname-test") for NAMECOM_USERNAME.
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=

# "sandbox" (default) uses https://api.dev.name.com — no real charges, no real DNS
# propagation. "production" uses https://api.name.com and requires
# ALLOW_NAMECOM_PRODUCTION=true as an explicit second opt-in below.
NAMECOM_ENVIRONMENT=sandbox

# Only used if NAMECOM_ENVIRONMENT=production (or to override the base URL directly).
# ALLOW_NAMECOM_PRODUCTION=true
# NAMECOM_API_BASE_URL=

# Optional — without this, brand-name generation falls back to a deterministic
# offline generator so the app still runs end-to-end without an API key.
ANTHROPIC_API_KEY=

# IP address the app's DNS bootstrap step points newly-registered domains at
# (an A record at the apex). Any placeholder IP works in sandbox — DNS calls
# succeed and are readable back through the API, but won't publicly resolve.
LANDING_PAGE_HOST_IP=198.172.0.1
